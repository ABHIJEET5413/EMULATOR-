# Installed into /system/etc/init/droidbox-adb.rc in the provisioned guest.
# USB gadget support is absent in this VM; TCP ADB needs an explicit startup.
on property:sys.boot_completed=1
    # adbd alone cannot display RSA prompts: the framework's AdbService must
    # enable its debugging manager before an unrecognized host connects.
    exec u:r:shell:s0 shell shell -- /system/bin/sh /system/etc/droidbox-first-boot.sh
    setprop persist.adb.tcp.port 5555
    setprop service.adb.tcp.port 5555
    start adbd
